# Local SQLite demo database. Prisma resolves this path relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Development-only shared demo key; replace before trying operator review.
# Use a private random string of at least 12 characters. Never commit the real value.
DEMO_OPERATOR_KEY="replace-with-private-dev-key"
\n# Optional operator-triggered semantic AI model comparison, not needed for regular demo.\n# Real values must never be committed or exposed in browser code.\n# OPENAI_API_KEY=""\n